<Project Sdk="Godot.NET.Sdk/4.5.1">
    <Import Project="$(MSBuildThisFileDirectory)local.props" Condition="Exists('$(MSBuildThisFileDirectory)local.props')"/>

    <!-- Collector as a standalone mod (ADR 0003 / CONTEXT.md "Mod Packaging"): unlike SlimeBoss,
         this is a genuinely separate, independently-loadable Workshop item with its own manifest/
         ModId - players deliberately subscribe to it while it's still in development, separate
         from the core Downfall download. The game's own ModManager discovers and loads it the
         normal way (Collector.json -> Collector.dll/.pck), exactly like Downfall's own manifest.
         CollectorMainFile keeps its own [ModInitializer] - it is NOT loaded by reflection from
         DownfallMainFile the way SlimeBoss is. See .scratch/standalone-submods/issues/04-*.md. -->

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>14</LangVersion>

        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>

        <!-- ModId "Collector" is both the manifest's "id" (so ModManager discovers Collector.json
             and loads exactly Collector.dll/.pck) and the existing CollectorMainFile.ModId
             constant used for its Logger/Harmony instance names - keeping both in sync avoids
             renaming that constant for this extraction. ModOutputFolder is its own ("Collector"),
             distinct from Downfall's, so it lands as its own separate mods/Collector/ entry. -->
        <ModId>Collector</ModId>
        <ModName Condition="'$(ModName)' == ''">$(ModId)</ModName>
        <AssemblyName>$(ModId)</AssemblyName>
        <ModOutputFolder>$(ModId)</ModOutputFolder>
        <PackFolders>Collector</PackFolders>

        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultItemExcludes>
            packages/**;
            src/**;shaders/**;steam/**;System/**;themes/**;addons/**;
            animations/**;banks/**;debug_audio/**;fonts/**;images/**;
            localization/**;materials/**;models/**;RiderTestRunner/**;scenes/**
        </DefaultItemExcludes>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>

        <!-- Intermediate output dir: see Directory.Build.props at repo root (this project is the
             reason it exists - see that file's comment for the Publicizer cache collision this
             used to cause, reproduced and confirmed while first building this project). -->

        <NoWarn>$(NoWarn);MSB3270;CS0436</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <AssemblyVersion>0.1.20.0</AssemblyVersion>
        <FileVersion>0.1.20.0</FileVersion>
        <Version>0.1.20</Version>
        <BaseLibVersion>3.4.7</BaseLibVersion>
        <UseLocalBaseLib Condition="'$(UseLocalBaseLib)' == ''">false</UseLocalBaseLib>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <Optimize>false</Optimize>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <Optimize>true</Optimize>
        <DebugType>none</DebugType>
        <PathMap>$(AppOutputBase)=.\</PathMap>
    </PropertyGroup>

    <ItemGroup>
        <None Include="Collector.json"/>
    </ItemGroup>

    <!-- OS detection, game assembly references, BaseLib/Publicizer setup: mirrors Downfall.csproj/
         SlimeBoss.csproj. Kept duplicated rather than factored into a shared .props file, same
         rationale as SlimeBoss.csproj's own header comment - a shared-props cleanup can happen
         later if a third project needs this scaffolding again. -->
    <PropertyGroup>
        <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
        <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
        <IsOSX Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsOSX>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsWindows)' == 'true'">
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath Condition="'$(ModsPath)' == ''">$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsLinux)' == 'true'">
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath Condition="'$(ModsPath)' == ''">$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsOSX)' == 'true'">
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath Condition="'$(ModsPath)' == ''">$(Sts2Path)/SlayTheSpire2.app/Contents/MacOS/mods/</ModsPath>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_x86_64</Sts2DataDir>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
            <Publicize>true</Publicize>
        </Reference>
        <Reference Include="SmartFormat">
            <HintPath>$(Sts2DataDir)/SmartFormat.dll</HintPath>
        </Reference>
        <Reference Include="Steamworks.NET">
            <HintPath>$(Sts2DataDir)/Steamworks.NET.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="!Exists('$(Sts2DataDir)')">
        <PackageReference Include="lamali.StS2.RefLib" Version="0.111.0-beta" ExcludeAssets="runtime" PrivateAssets="all"/>
        <PackageReference Include="SmartFormat.NET" Version="3.*" ExcludeAssets="runtime" PrivateAssets="all"/>
        <PackageReference Include="Steamworks.NET" Version="2024.8.0" ExcludeAssets="runtime" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="BaseLib" Condition="'$(UseLocalBaseLib)' == 'true'">
            <HintPath>C:\Users\lamal\Desktop\Programmieren\sts2mods\BaseLib-StS2\publish\BaseLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <PackageReference Include="Alchyr.Sts2.BaseLib" Version="$(BaseLibVersion)" Condition="'$(UseLocalBaseLib)' != 'true'"/>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="0.2.1"/>
    </ItemGroup>

    <!-- Reference the core Downfall project for shared framework types (DownfallCode, and
         transitively Awakened/Champ/Guardian/Hexaghost/Snecko, which are still bundled submods
         compiled directly into Downfall.dll). Also reference SlimeBoss.csproj directly - SlimeBoss
         is its own internal-submod assembly (SlimeBoss.dll) now, no longer part of Downfall.dll, so
         a project that needs its types has to reference it separately. Collector -> SlimeBoss is a
         normal, uncomplicated ProjectReference: it's only core (Downfall) -> SlimeBoss that had to
         avoid a circular reference (see ADR 0003's Implementation note). Hermit is likewise its own
         internal-submod assembly now (Hermit.csproj/Hermit.dll) - no ProjectReference to it is
         added here since `grep -rl Hermit CollectorCode/` finds no actual compile-time reference
         into HermitCode; add one the same way as SlimeBoss's above if that ever changes. -->
    <ItemGroup>
        <ProjectReference Include="Downfall.csproj"/>
        <ProjectReference Include="SlimeBoss.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Publicize Include="sts2:MegaCrit.Sts2.Core.Combat.History.CombatHistory.Add"/>

        <Publicize Include="sts2:MegaCrit.Sts2.Core.Commands.Builders.AttackCommand+SourceType"/>
        <Publicize Include="sts2:MegaCrit.Sts2.Core.Commands.Builders.AttackCommand.Attacker"/>
        <Publicize Include="sts2:MegaCrit.Sts2.Core.Commands.Builders.AttackCommand.IsRandomlyTargeted"/>
        <Publicize Include="sts2:MegaCrit.Sts2.Core.Commands.Builders.AttackCommand.ModelSource"/>
        <Publicize Include="sts2:MegaCrit.Sts2.Core.Commands.Builders.AttackCommand._attackerAnimDelay"/>
        <Publicize Include="sts2:MegaCrit.Sts2.Core.Commands.Builders.AttackCommand._attackerAnimName"/>
        <Publicize Include="sts2:MegaCrit.Sts2.Core.Commands.Builders.AttackCommand._combatState"/>
        <Publicize Include="sts2:MegaCrit.Sts2.Core.Commands.Builders.AttackCommand._singleTarget"/>
        <Publicize Include="sts2:MegaCrit.Sts2.Core.Commands.Builders.AttackCommand._sourceType"/>

        <Publicize Include="sts2:MegaCrit.Sts2.Core.Models.CardModel._owner"/>


        <Publicize Include="sts2:MegaCrit.Sts2.Core.Nodes.Screens.CardLibrary.NCardLibrary.UpdateCardPoolFilter"/>
        <Publicize Include="sts2:MegaCrit.Sts2.Core.Nodes.Screens.CardLibrary.NCardLibrary._lastHoveredControl"/>
        <Publicize Include="sts2:MegaCrit.Sts2.Core.Nodes.Screens.CardLibrary.NCardLibrary._miscPoolFilter"/>
        <Publicize Include="sts2:MegaCrit.Sts2.Core.Nodes.Screens.CardLibrary.NCardLibrary._poolFilters"/>

    </ItemGroup>
    <ItemGroup>
        <Publicize Include="BaseLib" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false">
            <Members>
                M:BaseLib.Abstracts.ConstructedCardModel.WithKeyword(MegaCrit.Sts2.Core.Entities.Cards.CardKeyword,BaseLib.Abstracts.ConstructedCardModel.UpgradeType);
                M:BaseLib.Abstracts.ConstructedCardModel.WithKeywords(MegaCrit.Sts2.Core.Entities.Cards.CardKeyword[]);
                M:BaseLib.Abstracts.ConstructedCardModel.WithTip(BaseLib.Utils.TooltipSource);
                M:BaseLib.Abstracts.ConstructedCardModel.WithTips(System.Func{MegaCrit.Sts2.Core.Models.CardModel,System.Collections.Generic.IEnumerable{MegaCrit.Sts2.Core.HoverTips.IHoverTip}});
            </Members>
        </Publicize>
    </ItemGroup>

    <ItemGroup>
        <Compile Include="CollectorCode/**/*.cs" Exclude="CollectorCode/Tests/**/*.cs"/>
        <AdditionalFiles Include="Collector/**/*"/>
        <Using Include="Downfall.DownfallCode.Extensions"/>
    </ItemGroup>

    <!-- Collector's own [CardTest]s (none yet) would need TestCode's infra (CardTestAttribute,
         TestContext, ...), which only exists in Downfall.dll when Downfall.csproj itself is built
         with "Test" in its Submods - same opt-in flag as every other character's tests, read from
         the same local.props this project already imports. Mirrors SlimeBoss.csproj's own block. -->
    <ItemGroup Condition="'$(Submods)' != '' and $(Submods.Contains('Test'))">
        <Compile Include="CollectorCode/Tests/**/*.cs"/>
    </ItemGroup>

    <Target Name="GenerateModManifest">
        <PropertyGroup>
            <_ModManifestJson>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Collector.json'))</_ModManifestJson>
        </PropertyGroup>
        <ItemGroup>
            <_ModManifestLine Remove="@(_ModManifestLine)"/>
            <_ModManifestLine Include="$(_ModManifestJson)"/>
        </ItemGroup>
        <WriteLinesToFile File="$(IntermediateOutputPath)$(ModId).json" Lines="@(_ModManifestLine)" Overwrite="true"/>
    </Target>

    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent" DependsOnTargets="GenerateModManifest">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(ModOutputFolder)/"/>
        <Copy SourceFiles="$(IntermediateOutputPath)$(ModId).json" DestinationFolder="$(ModsPath)$(ModOutputFolder)/"/>
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(ModsPath)$(ModOutputFolder)/"
              Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>
    </Target>

    <Target Name="GodotImport" BeforeTargets="GodotPublish"
            Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(SkipGodotImport)' != 'true'">
        <Exec Command="&quot;$(GodotPath)&quot; --headless --audio-driver Dummy --path &quot;$(MSBuildProjectDirectory)&quot; --import --quit --extra-args --no-window"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1;Configuration=$(Configuration)"
              IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"/>
    </Target>

    <!-- Packs Collector/ into its own Collector.pck, dropped into its own mods/Collector/ folder
         next to Collector.dll and Collector.json, so ModManager discovers and loads it as a
         genuinely separate mod entry - unlike SlimeBoss.csproj's GodotPublish, which deliberately
         lands its pck inside mods/Downfall/ instead. -->
    <Target Name="GodotPublish" AfterTargets="Publish"
            Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <Message Text="--- PACKING COLLECTOR RELEASE: '$(PackFolders)' ---" Importance="high"/>
        <Exec Command="&quot;$(GodotPath)&quot; --headless --audio-driver Dummy --path &quot;$(MSBuildProjectDirectory)&quot; -s build/pack_mod.gd -- &quot;$(ModsPath)$(ModOutputFolder)/$(ModId).pck&quot; $(PackFolders.Replace(';', ' '))"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1;Configuration=$(Configuration)"
              IgnoreExitCode="false" IgnoreStandardErrorWarningFormat="true"/>
    </Target>
</Project>
