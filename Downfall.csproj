    <!-- PackFolders drives which top-level asset folders build/pack_mod.gd packs into Downfall.pck.
         Computed from $(Submods) rather than aliased to it directly, and with "SlimeBoss" always
         stripped out, so Downfall.pck never bundles SlimeBoss's assets even if an un-updated
         local.props still lists "SlimeBoss" in Submods. SlimeBoss is an internal submod (ADR
         0003): although it has no manifest/ModId of its own (so the game's own manifest-driven
         mod loader would never discover a separate "SlimeBoss.pck"), its assets still ship in
         their OWN pck, built by SlimeBoss.csproj and loaded explicitly at runtime via
         Godot.ProjectSettings.LoadResourcePack(...) from DownfallMainFile.Initialize() - the same
         "call it directly, don't rely on manifest-driven discovery" pattern used for its code
         (see DownfallMainFile.InitializeSlimeBoss()). Kept as its own pck, not merged into
         Downfall.pck, so a future SlimeBoss Beta replacement mod can ship genuinely different
         assets under the same resource paths without colliding with stock SlimeBoss's. -->
    <ItemGroup>
        <_PackFolder Include="$(Submods)"/>
        <_PackFolder Remove="SlimeBoss"/>
    </ItemGroup>
    <PropertyGroup>
        <PackFolders>@(_PackFolder, ';')</PackFolders>
    </PropertyGroup>

    <ItemGroup Condition="$(Submods.Contains('Downfall'))">
        <Compile Include="DownfallCode/**/*.cs"/>
        <AdditionalFiles Include="Downfall/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Automaton'))">
        <Compile Include="AutomatonCode/**/*.cs"/>
        <AdditionalFiles Include="Automaton/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Awakened'))">
        <Compile Include="AwakenedCode/**/*.cs"/>
        <AdditionalFiles Include="Awakened/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Champ'))">
        <Compile Include="ChampCode/**/*.cs"/>
        <AdditionalFiles Include="Champ/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Gremlins'))">
        <Compile Include="GremlinsCode/**/*.cs"/>
        <AdditionalFiles Include="Gremlins/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Guardian'))">
        <Compile Include="GuardianCode/**/*.cs"/>
        <AdditionalFiles Include="Guardian/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Hexaghost'))">
        <Compile Include="HexaghostCode/**/*.cs"/>
        <AdditionalFiles Include="Hexaghost/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Hermit'))">
        <Compile Include="HermitCode/**/*.cs"/>
        <AdditionalFiles Include="Hermit/**/*"/>
    </ItemGroup>
    <!-- SlimeBoss has no branch here anymore: its C# code and assets both live in its own
         SlimeBoss.csproj (internal submod, own SlimeBoss.dll/SlimeBoss.pck, loaded directly by
         DownfallMainFile - see ADR 0003). Deliberately not reacting to "SlimeBoss" in $(Submods)
         even if an un-updated local.props still lists it - see the Submods default comment above. -->
    <ItemGroup Condition="$(Submods.Contains('Snecko'))">
        <Compile Include="SneckoCode/**/*.cs"/>
        <AdditionalFiles Include="Snecko/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Collector'))">
        <Compile Include="CollectorCode/**/*.cs"/>
        <AdditionalFiles Include="Collector/**/*"/>
    </ItemGroup>

    <ItemGroup Condition="$(Submods.Contains('Test'))">
        <Compile Include="TestCode/**/*.cs"/>
        <AdditionalFiles Include="Test/**/*"/>
    </ItemGroup>
    <ItemGroup>
        <Using Include="Downfall.DownfallCode.Extensions"/>
    </ItemGroup>



    <Target Name="ReportSubmods" BeforeTargets="CoreCompile">
        <Message Text="Building submods: '$(Submods)'" Importance="high"/>
    </Target>

    <!-- Downfall.json is the checked-in template/source of truth (CI bumps its version/
         min_game_version fields in place); this rewrites just "id" and "name" into a copy
         so a custom ModId/ModName build doesn't collide with a normal Downfall install.
         With the default ModId/ModName ("Downfall"), the rewrite is a no-op. -->
    <Target Name="GenerateModManifest">
        <PropertyGroup>
            <_ModManifestJson>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Downfall.json'))</_ModManifestJson>
            <!-- Anchored to the top-level "id" immediately followed by "name" (the manifest's
                 first two keys) so this can't also match "id" inside the "dependencies" array. -->
            <_ModManifestJson>$([System.Text.RegularExpressions.Regex]::Replace($(_ModManifestJson), '("id"\s*:\s*)"[^"]*"(\s*,\s*"name"\s*:\s*)"[^"]*"', '$1"$(ModId)"$2"$(ModName)"'))</_ModManifestJson>
        </PropertyGroup>
        <ItemGroup>
            <_ModManifestLine Remove="@(_ModManifestLine)"/>
            <_ModManifestLine Include="$(_ModManifestJson)"/>
        </ItemGroup>
        <WriteLinesToFile File="$(IntermediateOutputPath)$(ModId).json" Lines="@(_ModManifestLine)" Overwrite="true"/>
    </Target>

    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent" DependsOnTargets="GenerateModManifest">
         <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(ModOutputFolder)/"/>
        <Copy SourceFiles="$(IntermediateOutputPath)$(ModId).json" DestinationFolder="$(ModsPath)$(ModOutputFolder)/"/>
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(ModsPath)$(ModOutputFolder)/"
              Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>

        <Message Text="Copying BaseLib dependencies..." Importance="high"/>

        <ItemGroup Condition="'$(UseLocalBaseLib)' != 'true'">
            <BaseLibFiles Include="
                $(NuGetPackageRoot)alchyr.sts2.baselib/$(BaseLibVersion)/lib/**/BaseLib.dll;
                $(NuGetPackageRoot)alchyr.sts2.baselib/$(BaseLibVersion)/Content/BaseLib.pck;
                $(NuGetPackageRoot)alchyr.sts2.baselib/$(BaseLibVersion)/Content/BaseLib.json;
            "/>
        </ItemGroup>

        <Copy SourceFiles="@(BaseLibFiles)" DestinationFolder="$(ModsPath)BaseLib/"/>
    </Target>

    <Target Name="GodotImport" BeforeTargets="GodotPublish"
            Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(SkipGodotImport)' != 'true'">
        <Exec Command="&quot;$(GodotPath)&quot; --headless --audio-driver Dummy --path &quot;$(MSBuildProjectDirectory)&quot; --import --quit --extra-args --no-window"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1;Configuration=$(Configuration)"
              IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"/>
    </Target>

    <Target Name="GodotPublish" AfterTargets="Publish"
            Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <Message Text="--- PACKING COMBINED RELEASE: '$(PackFolders)' ---" Importance="high"/>
        <Exec Command="&quot;$(GodotPath)&quot; --headless --audio-driver Dummy --path &quot;$(MSBuildProjectDirectory)&quot; -s build/pack_mod.gd -- &quot;$(ModsPath)$(ModOutputFolder)/$(ModId).pck&quot; @(_PackFolder, ' ')"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1;Configuration=$(Configuration)"
              IgnoreExitCode="false" IgnoreStandardErrorWarningFormat="true"/>
    </Target>
    <Import Project="addons/sentry/dotnet/Sentry.Godot.props" Condition="Exists('addons/sentry/dotnet/Sentry.Godot.props')" />
</Project>