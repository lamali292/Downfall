<Project Sdk="Godot.NET.Sdk/4.5.1">
    <Import Project="$(MSBuildThisFileDirectory)local.props" Condition="Exists('$(MSBuildThisFileDirectory)local.props')"/>

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>14</LangVersion>

        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
        
        <AssemblyName>Downfall</AssemblyName>
        <ModOutputFolder>Downfall</ModOutputFolder>
        
        <Submods Condition="'$(Submods)' == ''">Downfall;Automaton;Awakened;Champ;Guardian;Hexaghost;Hermit;SlimeBoss;Snecko</Submods>
        <PackFolders>$(Submods)</PackFolders>
        
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultItemExcludes>
            packages/**;
            src/**;shaders/**;steam/**;System/**;themes/**;addons/**;
            animations/**;banks/**;debug_audio/**;fonts/**;images/**;
            localization/**;materials/**;models/**;RiderTestRunner/**;scenes/**
        </DefaultItemExcludes>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
     
        <NoWarn>$(NoWarn);MSB3270;CS0436</NoWarn>
       
    </PropertyGroup>
    
    <PropertyGroup>
        <AssemblyVersion>0.1.16.0</AssemblyVersion>
        <FileVersion>0.1.16.0</FileVersion>
        <Version>0.1.16</Version>
        <BaseLibVersion>3.4.5</BaseLibVersion>
        <UseLocalBaseLib Condition="'$(UseLocalBaseLib)' == ''">false</UseLocalBaseLib>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <Optimize>false</Optimize>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <Optimize>true</Optimize>
        <DebugType>none</DebugType>
        <PathMap>$(AppOutputBase)=.\</PathMap>
    </PropertyGroup>

    <!-- OS Detection -->
    <ItemGroup>
        <None Include="Downfall.json"/>
        <None Include="local.props"/>
        <None Include="local.props.example"/>
        <None Include=".gitignore"/>
    </ItemGroup>
    <PropertyGroup>
        <IsWindows Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</IsWindows>
        <IsLinux Condition="$([MSBuild]::IsOSPlatform('Linux'))">true</IsLinux>
        <IsOSX Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsOSX>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsWindows)' == 'true'">
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath Condition="'$(ModsPath)' == ''">$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsLinux)' == 'true'">
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath Condition="'$(ModsPath)' == ''">$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsOSX)' == 'true'">
        <Sts2Path Condition="'$(Sts2Path)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2</Sts2Path>
        <ModsPath Condition="'$(ModsPath)' == ''">$(Sts2Path)/SlayTheSpire2.app/Contents/MacOS/mods/</ModsPath>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_x86_64</Sts2DataDir>
    </PropertyGroup>

    <!-- Game assemblies: real DLLs when STS2 is installed locally... -->
    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="SmartFormat">
            <HintPath>$(Sts2DataDir)/SmartFormat.dll</HintPath>
        </Reference>
        <Reference Include="Steamworks.NET">
            <HintPath>$(Sts2DataDir)/Steamworks.NET.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!-- ...reference assemblies from NuGet when it isn't (CI). -->
    <!-- RefLib covers sts2 + Harmony; SmartFormat and Steamworks come as compile-only packages
         (ExcludeAssets=runtime so the game's own DLLs are used at runtime, nothing is shipped). -->
    <ItemGroup Condition="!Exists('$(Sts2DataDir)')">
        <PackageReference Include="lamali.StS2.RefLib" Version="0.111.0-beta" ExcludeAssets="runtime" PrivateAssets="all"/>
        <PackageReference Include="SmartFormat.NET" Version="3.*" ExcludeAssets="runtime" PrivateAssets="all"/>
        <PackageReference Include="Steamworks.NET" Version="2024.8.0" ExcludeAssets="runtime" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="BaseLib" Condition="'$(UseLocalBaseLib)' == 'true'">
            <HintPath>C:\Users\lamal\Desktop\Programmieren\sts2mods\BaseLib-StS2\publish\BaseLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <PackageReference Include="Alchyr.Sts2.BaseLib" Version="$(BaseLibVersion)" Condition="'$(UseLocalBaseLib)' != 'true'"/>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="0.1.9"/>
    </ItemGroup>

    <ItemGroup>
        <Publicize Include="sts2" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false"/>
    </ItemGroup>
    <ItemGroup>
        <Publicize Include="BaseLib" IncludeVirtualMembers="false" IncludeCompilerGeneratedMembers="false">
            <Members>
                M:BaseLib.Abstracts.ConstructedCardModel.WithKeyword(MegaCrit.Sts2.Core.Entities.Cards.CardKeyword,BaseLib.Abstracts.ConstructedCardModel.UpgradeType);
                M:BaseLib.Abstracts.ConstructedCardModel.WithKeywords(MegaCrit.Sts2.Core.Entities.Cards.CardKeyword[]);
                M:BaseLib.Abstracts.ConstructedCardModel.WithTip(BaseLib.Utils.TooltipSource);
                M:BaseLib.Abstracts.ConstructedCardModel.WithTips(System.Func{MegaCrit.Sts2.Core.Models.CardModel,System.Collections.Generic.IEnumerable{MegaCrit.Sts2.Core.HoverTips.IHoverTip}});
            </Members>
        </Publicize>
    </ItemGroup>
 
    
    <ItemGroup Condition="$(Submods.Contains('Downfall'))">
        <Compile Include="DownfallCode/**/*.cs"/>
        <AdditionalFiles Include="Downfall/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Automaton'))">
        <Compile Include="AutomatonCode/**/*.cs"/>
        <AdditionalFiles Include="Automaton/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Awakened'))">
        <Compile Include="AwakenedCode/**/*.cs"/>
        <AdditionalFiles Include="Awakened/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Champ'))">
        <Compile Include="ChampCode/**/*.cs"/>
        <AdditionalFiles Include="Champ/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Guardian'))">
        <Compile Include="GuardianCode/**/*.cs"/>
        <AdditionalFiles Include="Guardian/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Hexaghost'))">
        <Compile Include="HexaghostCode/**/*.cs"/>
        <AdditionalFiles Include="Hexaghost/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Hermit'))">
        <Compile Include="HermitCode/**/*.cs"/>
        <AdditionalFiles Include="Hermit/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('SlimeBoss'))">
        <Compile Include="SlimeBossCode/**/*.cs"/>
        <AdditionalFiles Include="SlimeBoss/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Snecko'))">
        <Compile Include="SneckoCode/**/*.cs"/>
        <AdditionalFiles Include="Snecko/**/*"/>
    </ItemGroup>
    <ItemGroup Condition="$(Submods.Contains('Collector'))">
        <Compile Include="CollectorCode/**/*.cs"/>
        <AdditionalFiles Include="Collector/**/*"/>
    </ItemGroup>

    <ItemGroup Condition="$(Submods.Contains('Test'))">
        <Compile Include="TestCode/**/*.cs"/>
        <AdditionalFiles Include="Test/**/*"/>
    </ItemGroup>
    <ItemGroup>
        <Using Include="Downfall.DownfallCode.Extensions"/>
    </ItemGroup>



    <Target Name="ReportSubmods" BeforeTargets="CoreCompile">
        <Message Text="Building submods: '$(Submods)'" Importance="high"/>
    </Target>

    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent">
         <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(ModOutputFolder)/"/>
        <Copy SourceFiles="Downfall.json" DestinationFolder="$(ModsPath)$(ModOutputFolder)/"/>
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(ModsPath)$(ModOutputFolder)/"
              Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>

        <Message Text="Copying BaseLib dependencies..." Importance="high"/>

        <ItemGroup Condition="'$(UseLocalBaseLib)' != 'true'">
            <BaseLibFiles Include="
                $(NuGetPackageRoot)alchyr.sts2.baselib/$(BaseLibVersion)/lib/**/BaseLib.dll;
                $(NuGetPackageRoot)alchyr.sts2.baselib/$(BaseLibVersion)/Content/BaseLib.pck;
                $(NuGetPackageRoot)alchyr.sts2.baselib/$(BaseLibVersion)/Content/BaseLib.json;
            "/>
        </ItemGroup>

        <Copy SourceFiles="@(BaseLibFiles)" DestinationFolder="$(ModsPath)BaseLib/"/>
    </Target>

    <Target Name="GodotImport" BeforeTargets="GodotPublish"
            Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(SkipGodotImport)' != 'true'">
        <Exec Command="&quot;$(GodotPath)&quot; --headless --audio-driver Dummy --path &quot;$(MSBuildProjectDirectory)&quot; --import --quit --extra-args --no-window"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1;Configuration=$(Configuration)"
              IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"/>
    </Target>

    <Target Name="GodotPublish" AfterTargets="Publish"
            Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <Message Text="--- PACKING COMBINED RELEASE: '$(PackFolders)' ---" Importance="high"/>
        <Exec Command="&quot;$(GodotPath)&quot; --headless --audio-driver Dummy --path &quot;$(MSBuildProjectDirectory)&quot; -s build/pack_mod.gd -- &quot;$(ModsPath)$(ModOutputFolder)/Downfall.pck&quot; $(PackFolders.Replace(';', ' '))"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1;Configuration=$(Configuration)"
              IgnoreExitCode="false" IgnoreStandardErrorWarningFormat="true"/>
    </Target>
    <Import Project="addons/sentry/dotnet/Sentry.Godot.props" Condition="Exists('addons/sentry/dotnet/Sentry.Godot.props')" />
</Project>