<Project Sdk="Godot.NET.Sdk/4.5.1">
    <!-- Pull in SteamLibraryPath / AssetSourcePath / GodotPath -->
    <Import Project="local.props" Condition="Exists('local.props')" />

    <PropertyGroup>
        <AssemblyName>sts2</AssemblyName>
        <EnableDynamicLoading>True</EnableDynamicLoading>
        <Nullable>enable</Nullable>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>13.0</LangVersion>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    </PropertyGroup>

    <!-- Derive the game data dir from local.props, with a fallback default -->
    <PropertyGroup>
        <SteamLibraryPath Condition="'$(SteamLibraryPath)' == ''">C:/Program Files (x86)/Steam/steamapps</SteamLibraryPath>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(SteamLibraryPath)/common/Slay the Spire 2/data_sts2_windows_x86_64</Sts2DataDir>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2023.3.0" />
        <PackageReference Include="MonoMod.Backports" Version="1.1.2" />
        <PackageReference Include="Sentry" Version="6.7.0" />
        <PackageReference Include="SmartFormat" Version="3.3.0" />
        <PackageReference Include="System.IO.Hashing" Version="9.0.0" />
        <PackageReference Include="Vortice.DXGI" Version="3.6.2" />
    </ItemGroup>
    <ItemGroup>
        <Compile Remove="DownfallCode/**/*.cs" />
        <Compile Remove="AutomatonCode/**/*.cs" />
        <Compile Remove="AwakenedCode/**/*.cs" />
        <Compile Remove="ChampCode/**/*.cs" />
        <Compile Remove="CollectorCode/**/*.cs" />
        <Compile Remove="GremlinsCode/**/*.cs" />
        <Compile Remove="GuardianCode/**/*.cs" />
        <Compile Remove="HexaghostCode/**/*.cs" />
        <Compile Remove="HermitCode/**/*.cs" />
        <Compile Remove="SlimeBossCode/**/*.cs" />
        <Compile Remove="SneckoCode/**/*.cs" />
        <Compile Remove="ImageGen/**/*.cs" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Sentry.Godot">
            <HintPath>$(Sts2DataDir)/Sentry.Godot.dll</HintPath>
        </Reference>
        <Reference Include="Steamworks.NET">
            <HintPath>$(Sts2DataDir)/Steamworks.NET.dll</HintPath>
        </Reference>
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
        </Reference>
        <Reference Include="SharpGen.Runtime">
            <HintPath>$(Sts2DataDir)/SharpGen.Runtime.dll</HintPath>
        </Reference>
    </ItemGroup>

    <Import Project="addons/sentry/dotnet/Sentry.Godot.props" Condition="Exists('addons/sentry/dotnet/Sentry.Godot.props')" />
</Project>