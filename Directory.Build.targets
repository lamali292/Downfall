<Project>
    <!-- Game install selection: local.props sets Sts2Branch (beta|public) plus Sts2BetaPath/Sts2PublicPath.
         An explicit -p:Sts2Path=... on the command line still wins. -->
    <PropertyGroup>
        <Sts2Branch Condition="'$(Sts2Branch)' == ''">beta</Sts2Branch>
        <Sts2Path Condition="'$(Sts2Path)' == '' and '$(Sts2Branch)' == 'public'">$(Sts2PublicPath)</Sts2Path>
        <Sts2Path Condition="'$(Sts2Path)' == '' and '$(Sts2Branch)' == 'beta'">$(Sts2BetaPath)</Sts2Path>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsWindows)' == 'true'">
        <ModsPath Condition="'$(ModsPath)' == ''">$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/data_sts2_windows_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsLinux)' == 'true'">
        <ModsPath Condition="'$(ModsPath)' == ''">$(Sts2Path)/mods/</ModsPath>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/data_sts2_linuxbsd_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(IsOSX)' == 'true'">
        <ModsPath Condition="'$(ModsPath)' == ''">$(Sts2Path)/SlayTheSpire2.app/Contents/MacOS/mods/</ModsPath>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == ''">$(Sts2Path)/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_x86_64</Sts2DataDir>
    </PropertyGroup>

    <!--
        In the real game, sts2.dll/0Harmony.dll are already loaded into the process (it IS sts2.exe), so these
        stay Private=false (not copied to the mod's own output) for every shipping config. The Godot editor's
        own process is not the game, so it has no such assembly loaded - the Debug (editor) config needs these
        copied locally or GameScriptRegistration's typeof(NFtue).Assembly access throws FileNotFoundException
        trying to resolve "sts2" at runtime. Mirrors ModRemoteScene's mod.build.props.
    -->
    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private Condition="'$(Configuration)' == 'Debug'">true</Private>
            <Private Condition="'$(Configuration)' != 'Debug'">false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private Condition="'$(Configuration)' == 'Debug'">true</Private>
            <Private Condition="'$(Configuration)' != 'Debug'">false</Private>
            <Publicize Condition="'$(PublicizeSts2Reference)' != 'false'">true</Publicize>
        </Reference>
        <Reference Include="SmartFormat">
            <HintPath>$(Sts2DataDir)/SmartFormat.dll</HintPath>
        </Reference>
        <Reference Include="Steamworks.NET">
            <HintPath>$(Sts2DataDir)/Steamworks.NET.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup Condition="!Exists('$(Sts2DataDir)')">
        <PackageReference Include="lamali.StS2.RefLib" Version="0.111.0-beta" ExcludeAssets="runtime" PrivateAssets="all"/>
        <PackageReference Include="SmartFormat.NET" Version="3.*" ExcludeAssets="runtime" PrivateAssets="all"/>
        <PackageReference Include="Steamworks.NET" Version="2024.8.0" ExcludeAssets="runtime" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="BaseLib" Condition="'$(UseLocalBaseLib)' == 'true'">
            <HintPath>C:\Users\lamal\Desktop\Programmieren\sts2mods\BaseLib-StS2\publish\BaseLib.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <PackageReference Include="Alchyr.Sts2.BaseLib" Version="$(BaseLibVersion)" Condition="'$(UseLocalBaseLib)' != 'true'"/>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0" PrivateAssets="All"/>
        <PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="0.2.1"/>
    </ItemGroup>

    <Target Name="GodotImport" BeforeTargets="GodotPublish"
            Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(SkipGodotImport)' != 'true'">
        <Exec Command="&quot;$(GodotPath)&quot; --headless --audio-driver Dummy --path &quot;$(MSBuildProjectDirectory)&quot; --import --quit --extra-args --no-window"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1;Configuration=$(Configuration)"
              IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true"/>
    </Target>

    <!--
        So the Godot editor, launched standalone on this project (not through the game's own exe), can load mods
        the same way the game does: the engine resolves a relative "mods" folder next to its own executable, i.e.
        next to GodotPath rather than next to Sts2Path. Opt in via local.props: <CopyToGodotMods>true</CopyToGodotMods>.
    -->
    <PropertyGroup Condition="'$(GodotPath)' != ''">
        <GodotRoot Condition="'$(GodotRoot)' == ''">$([System.IO.Path]::GetDirectoryName('$(GodotPath)'))</GodotRoot>
        <GodotModsPath Condition="'$(GodotModsPath)' == ''">$(GodotRoot)\mods</GodotModsPath>
    </PropertyGroup>
    <PropertyGroup>
        <CopyToGodotMods Condition="'$(CopyToGodotMods)' == ''">false</CopyToGodotMods>
    </PropertyGroup>

    <PropertyGroup>
        <IsStandaloneMod Condition="'$(IsStandaloneMod)' == ''">false</IsStandaloneMod>
        <ModOutputFolder Condition="'$(ModOutputFolder)' == '' and '$(IsStandaloneMod)' == 'true'">$(ModId)</ModOutputFolder>
        <ModOutputFolder Condition="'$(ModOutputFolder)' == ''">Downfall</ModOutputFolder>
        <ModName Condition="'$(ModName)' == ''">$(ModId)</ModName>
        <ModManifestFile Condition="'$(ModManifestFile)' == ''">$(MSBuildProjectName).json</ModManifestFile>
    </PropertyGroup>

    <Target Name="GenerateModManifest" Condition="'$(IsStandaloneMod)' == 'true'">
        <PropertyGroup>
            <_ModManifestJson>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\$(ModManifestFile)'))</_ModManifestJson>
            <_ModManifestJson>$([System.Text.RegularExpressions.Regex]::Replace($(_ModManifestJson), '("id"\s*:\s*)"[^"]*"(\s*,\s*"name"\s*:\s*)"[^"]*"', '$1"$(ModId)"$2"$(ModName)"'))</_ModManifestJson>
        </PropertyGroup>
        <ItemGroup>
            <_ModManifestLine Remove="@(_ModManifestLine)"/>
            <_ModManifestLine Include="$(_ModManifestJson)"/>
        </ItemGroup>
        <WriteLinesToFile File="$(IntermediateOutputPath)$(ModId).json" Lines="@(_ModManifestLine)" Overwrite="true"/>
    </Target>

    <!-- "Debug" is reserved for the Godot editor itself (see the TOOLS comment in Directory.Build.props) and
         never ships as a loadable mod, so it never gets copied into either mods folder. -->
    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent" DependsOnTargets="GenerateModManifest"
            Condition="'$(Configuration)' != 'Debug'">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(ModOutputFolder)/"/>
        <Copy SourceFiles="$(IntermediateOutputPath)$(ModId).json" DestinationFolder="$(ModsPath)$(ModOutputFolder)/"
              Condition="'$(IsStandaloneMod)' == 'true'"/>
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(ModsPath)$(ModOutputFolder)/"
              Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>
    </Target>

    <!-- Build also mirrors the dll/pdb/manifest into the other configured branch's mods folder, so building against
         one branch (e.g. beta) still leaves the other (e.g. public) loadable. The mirrored dll was compiled against
         THIS build's sts2.dll; build with -p:Sts2Branch=<other> to replace it with a natively-compiled one. The .pck
         is only produced by publish and is mirrored there. -->
    <Target Name="MirrorToOtherBranchModsOnBuild" AfterTargets="CopyToModsFolderOnBuild" DependsOnTargets="GenerateModManifest"
            Condition="'$(Configuration)' != 'Debug'">
        <PropertyGroup>
            <_BuildBetaModsPath Condition="'$(Sts2Path)' != '' and '$(Sts2BetaPath)' != ''">$(ModsPath.Replace('$(Sts2Path)', '$(Sts2BetaPath)'))</_BuildBetaModsPath>
            <_BuildPublicModsPath Condition="'$(Sts2Path)' != '' and '$(Sts2PublicPath)' != ''">$(ModsPath.Replace('$(Sts2Path)', '$(Sts2PublicPath)'))</_BuildPublicModsPath>
        </PropertyGroup>
        <ItemGroup>
            <_BuildMirrorFile Include="$(TargetPath)"/>
            <_BuildMirrorFile Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>
            <_BuildMirrorFile Include="$(IntermediateOutputPath)$(ModId).json" Condition="'$(IsStandaloneMod)' == 'true'"/>
            <_BuildMirrorDir Include="$(_BuildBetaModsPath)$(ModOutputFolder)/"
                             Condition="'$(Sts2BetaPath)' != '' and '$(Sts2BetaPath)' != '$(Sts2Path)' and Exists('$(Sts2BetaPath)')"/>
            <_BuildMirrorDir Include="$(_BuildPublicModsPath)$(ModOutputFolder)/"
                             Condition="'$(Sts2PublicPath)' != '' and '$(Sts2PublicPath)' != '$(Sts2Path)' and Exists('$(Sts2PublicPath)')"/>
        </ItemGroup>
        <Copy SourceFiles="@(_BuildMirrorFile)" DestinationFolder="%(_BuildMirrorDir.Identity)" Condition="'@(_BuildMirrorDir)' != ''" ContinueOnError="true"/>
    </Target>

    <Target Name="CopyToGodotModsFolderOnBuild" AfterTargets="PostBuildEvent" DependsOnTargets="GenerateModManifest"
            Condition="'$(CopyToGodotMods)' == 'true' and '$(Configuration)' != 'Debug'">
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GodotModsPath)/$(ModOutputFolder)/"/>
        <Copy SourceFiles="$(IntermediateOutputPath)$(ModId).json" DestinationFolder="$(GodotModsPath)/$(ModOutputFolder)/"
              Condition="'$(IsStandaloneMod)' == 'true'"/>
        <Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
              DestinationFolder="$(GodotModsPath)/$(ModOutputFolder)/"
              Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>
    </Target>

    <Target Name="GodotPublish" AfterTargets="Publish"
            Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <Message Text="--- PACKING $(ModId) RELEASE: '$(PackFolders)' ---" Importance="high"/>
        <ItemGroup>
            <_PackFolderList Remove="@(_PackFolderList)"/>
            <_PackFolderList Include="$(PackFolders)"/>
        </ItemGroup>
        <Exec Command="&quot;$(GodotPath)&quot; --headless --audio-driver Dummy --path &quot;$(MSBuildProjectDirectory)&quot; -s build/pack_mod.gd -- &quot;$(ModsPath)$(ModOutputFolder)/$(ModId).pck&quot; @(_PackFolderList, ' ')"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1;Configuration=$(Configuration)"
              IgnoreExitCode="false" IgnoreStandardErrorWarningFormat="true"/>
        <Copy SourceFiles="$(ModsPath)$(ModOutputFolder)/$(ModId).pck"
              DestinationFolder="$(GodotModsPath)/$(ModOutputFolder)/"
              Condition="'$(CopyToGodotMods)' == 'true' and '$(Configuration)' != 'Debug'"/>

        <!-- Publish mirrors the whole mod (dll, pdb, manifest, pck) into the other configured branch's mods folder,
             so one publish leaves both game installs loadable. The mirrored dll was compiled against THIS build's
             sts2.dll; build with -p:Sts2Branch=<other> afterwards to replace it with a natively-compiled one. -->
        <PropertyGroup>
            <_BetaModsPath Condition="'$(Sts2Path)' != '' and '$(Sts2BetaPath)' != ''">$(ModsPath.Replace('$(Sts2Path)', '$(Sts2BetaPath)'))</_BetaModsPath>
            <_PublicModsPath Condition="'$(Sts2Path)' != '' and '$(Sts2PublicPath)' != ''">$(ModsPath.Replace('$(Sts2Path)', '$(Sts2PublicPath)'))</_PublicModsPath>
        </PropertyGroup>
        <ItemGroup>
            <_MirrorFile Include="$(TargetPath);$(ModsPath)$(ModOutputFolder)/$(ModId).pck"/>
            <_MirrorFile Include="$(TargetDir)$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')"/>
            <_MirrorFile Include="$(IntermediateOutputPath)$(ModId).json" Condition="'$(IsStandaloneMod)' == 'true'"/>
            <_MirrorDir Include="$(_BetaModsPath)$(ModOutputFolder)/"
                        Condition="'$(Sts2BetaPath)' != '' and '$(Sts2BetaPath)' != '$(Sts2Path)' and Exists('$(Sts2BetaPath)')"/>
            <_MirrorDir Include="$(_PublicModsPath)$(ModOutputFolder)/"
                        Condition="'$(Sts2PublicPath)' != '' and '$(Sts2PublicPath)' != '$(Sts2Path)' and Exists('$(Sts2PublicPath)')"/>
        </ItemGroup>
        <Copy SourceFiles="@(_MirrorFile)" DestinationFolder="%(_MirrorDir.Identity)" Condition="'@(_MirrorDir)' != ''"/>
    </Target>
</Project>
