<Project Sdk="Godot.NET.Sdk/4.5.1">
    <Import Project="$(MSBuildThisFileDirectory)local.props" Condition="Exists('$(MSBuildThisFileDirectory)local.props')"/>

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ModId Condition="'$(ModId)' == ''">Downfall</ModId>
        <ModName Condition="'$(ModName)' == ''">$(ModId)</ModName>
        <IsStandaloneMod>true</IsStandaloneMod>
        <!-- Debug is only what the editor builds: an empty stub (no code) that MoDot needs as the project assembly to
             mount sts2.dll. The real mod is the non-Debug build, loaded by the game's ModManager from the mods folder. -->
        <AssemblyName Condition="'$(Configuration)' == 'Debug'">DownfallEditorStub</AssemblyName>
        <AssemblyName Condition="'$(Configuration)' != 'Debug'">$(ModId)</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <None Include="Downfall.json"/>
        <None Include="local.props"/>
        <None Include="local.props.example"/>
        <None Include=".gitignore"/>
        <None Include="default_bus_layout.tres"/>
    </ItemGroup>

    <PropertyGroup>
        <PackFolders>Downfall</PackFolders>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
        <Compile Include="DownfallCode/**/*.cs"/>
        <Using Include="Downfall.DownfallCode.Extensions"/>
    </ItemGroup>
    <ItemGroup>
        <AdditionalFiles Include="Downfall/**/*"/>
    </ItemGroup>


    <Target Name="CopyBaseLibDependencies" AfterTargets="CopyToModsFolderOnBuild" Condition="'$(Configuration)' != 'Debug'">
        <Message Text="Copying BaseLib dependencies to the Godot editor mods folder..." Importance="high" Condition="'$(CopyToGodotMods)' == 'true'"/>

        <ItemGroup Condition="'$(UseLocalBaseLib)' != 'true'">
            <BaseLibFiles Include="
                $(NuGetPackageRoot)alchyr.sts2.baselib/$(BaseLibVersion)/lib/**/BaseLib.dll;
                $(NuGetPackageRoot)alchyr.sts2.baselib/$(BaseLibVersion)/Content/BaseLib.pck;
                $(NuGetPackageRoot)alchyr.sts2.baselib/$(BaseLibVersion)/Content/BaseLib.json;
            "/>
        </ItemGroup>

        <Copy SourceFiles="@(BaseLibFiles)" DestinationFolder="$(GodotModsPath)/BaseLib/" Condition="'$(CopyToGodotMods)' == 'true'"/>
    </Target>
    <Import Project="addons/sentry/dotnet/Sentry.Godot.props" Condition="Exists('addons/sentry/dotnet/Sentry.Godot.props')"/>

    <ItemGroup>
        <PackageReference Remove="Sentry"/>
    </ItemGroup>
    <ItemGroup Condition="Exists('$(Sts2DataDir)/Sentry.dll')">
        <Reference Include="Sentry">
            <HintPath>$(Sts2DataDir)/Sentry.dll</HintPath>
            <Private Condition="'$(Configuration)' == 'Debug'">true</Private>
            <Private Condition="'$(Configuration)' != 'Debug'">false</Private>
        </Reference>
    </ItemGroup>
</Project>
